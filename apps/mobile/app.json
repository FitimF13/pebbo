{
  "expo": {
    "name": "Pebbo",
    "slug": "pebbo",
    "scheme": "pebbo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f4ebe1",
    "ios": {
      "bundleIdentifier": "org.pebbo.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true },
        "NSLocalNetworkUsageDescription": "Pebbo verbindet sich in deinem Heimnetz mit deinem Pebbo."
      }
    },
    "android": {
      "package": "org.pebbo.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-secure-store",
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }]
    ]
  }
}
